{
  "private": true,
  "version": "0.0.0",
  "name": "@polymedia/spam-sdk",
  "author": "@juzybits (https://polymedia.app)",
  "homepage": "https://github.com/trungtt198x/polymedia-spam",
  "description": "An SDK to interact with the Spam package",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/trungtt198x/polymedia-spam"
  },
  "keywords": [
    "polymedia",
    "spam",
    "sdk"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "clean": "rm -rf dist/ node_modules/ .turbo/",
    "dev": "tsc --watch -p tsconfig.esm.json",
    "lint": "eslint src/ --report-unused-disable-directives --max-warnings 0",
    "prepublishOnly": "rm -rf dist/ && pnpm build",
    "typecheck": "tsc -p tsconfig.esm.json"
  },
  "dependencies": {
    "@iota/bcs": "^0.2.1",
    "@iota/iota-sdk": "^0.3.1",
    "@polymedia/suitcase-core": "^0.0.32"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/"
  ],
  "types": "./dist/cjs/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  }
}
