    "@polymedia/spam-sdk": "workspace:*",
    "@polymedia/suitcase-core": "^0.0.32",
    "@polymedia/suitcase-react": "^0.0.32",
    "@tanstack/react-query": "^5.66.11",
    "normalize.css": "^8.0.1",
    "react": "^18.3.1",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.2",
    "react-modal": "^3.16.3",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
